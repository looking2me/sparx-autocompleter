# Copy this file to ".env" and fill it in. ".env" is ignored by git and must never be shared or committed.

# Required: your Sparx login
SPARX_SCHOOL="Your School Name"   # Partial names work
SPARX_USERNAME="your-username"
SPARX_PASSWORD="your-password"

# Required for answering (OpenRouter, https://openrouter.ai)
OPENROUTER_API_KEY="your-openrouter-key"
OPENROUTER_TEXT_MODEL="model-id-for-text-questions"
OPENROUTER_VISION_MODEL="model-id-for-questions-with-pictures"

# Optional
# OPENROUTER_REASONING_EFFORT="medium"   # low, medium or high
# SPARX_HEADLESS="false"                 # Show the Chrome window while it works
# SPARX_UI_PORT="4173"                   # Port for the web interface
# PUPPETEER_EXECUTABLE_PATH=""           # Chrome location, if not the usual Windows one
